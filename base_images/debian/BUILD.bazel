load("//base_images/debian:debian13.bzl", "debian_image")

package(default_visibility = ["//visibility:public"])

debian_image(
    name = "debian",
    debian_packages = [
        # core packages
        "@debian13//ncurses-base",
        "@debian13//libncurses6",
        "@debian13//bash",
        "@debian13//dpkg",
        "@debian13//libstdc++6",
        "@debian13//curl",
        "@debian13//coreutils",
        "@debian13//base-files",
        "@debian13//netbase",
        "@debian13//tzdata",
        "@debian13//ca-certificates",
        "@debian13//libc6",
        "@debian13//libssl3t64",
        "@debian13//openssl",
        "@debian13//libgomp1",

        # Random utilities
        "@debian13//grep",
        "@debian13//sed",
        "@debian13//findutils",
    ],
    tars = [
        "//base_images/debian/core:passwd",
        "//base_images/debian/core:group",
        "//base_images/debian/core:symlinks_layer",
        "//base_images/debian/core:cacerts",
    ],
)
