load("@rules_distroless//distroless:defs.bzl", "passwd")
load("@rules_oci//oci:defs.bzl", "oci_push")
load("@rules_pkg//pkg:mappings.bzl", "pkg_mklink")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//base_images/debian:debian13.bzl", "debian_image")
load("//bazel/oci:defs.bzl", "image")

package(default_visibility = ["//visibility:public"])

passwd(
    name = "passwd",
    entries = [
        dict(
            gecos = ["root"],
            gid = 0,
            home = "/root",
            shell = "/usr/bin/bash",
            uid = 0,
            username = "root",
        ),
    ],
)

pkg_mklink(
    name = "usr_bin_python_symlink",
    link_name = "/usr/bin/python",
    target = "/usr/bin/python3.13",
)

pkg_mklink(
    name = "usr_bin_python3_symlink",
    link_name = "/usr/bin/python3",
    target = "/usr/bin/python3.13",
)

pkg_mklink(
    name = "usr_sbin_iptables",
    link_name = "/usr/sbin/iptables",
    target = "/usr/sbin/iptables-legacy",
)

pkg_mklink(
    name = "usr_sbin_ip6tables",
    link_name = "/usr/sbin/ip6tables",
    target = "/usr/sbin/ip6tables-legacy",
)

pkg_tar(
    name = "symlinks_layer",
    srcs = [
        ":usr_bin_python3_symlink",
        ":usr_bin_python_symlink",
        ":usr_sbin_ip6tables",
        ":usr_sbin_iptables",
    ],
)

pkg_tar(
    name = "docker_layer",
    srcs = [
        "@docker//:containerd-bin",
        "@docker//:containerd-shim-runc-v2-bin",
        "@docker//:ctr-bin",
        "@docker//:docker-bin",
        "@docker//:docker-init-bin",
        "@docker//:docker-proxy-bin",
        "@docker//:dockerd-bin",
        "@docker//:runc-bin",
    ],
    package_dir = "/usr/bin",
)

debian_image(
    name = "build_base",
    debian_packages = [
        "@debian13//thin-provisioning-tools",
        "@debian13//fuse-overlayfs",
        "@debian13//iptables",
        "@debian13//libmpfr6",
        "@debian13//libsigsegv2",
        "@debian13//grep",
        "@debian13//git",
        "@debian13//findutils",
        "@debian13//gawk",
        "@debian13//diffutils",
        "@debian13//sed",
        "@debian13//xz-utils",
        "@debian13//liblz4-1",
        "@debian13//libzstd-dev",
        "@debian13//coreutils",
        "@debian13//bash",
        # required to replicate distroless/static
        "@debian13//base-files",
        "@debian13//netbase",
        "@debian13//tzdata",
        "@debian13//ca-certificates",
        # required to replicate distroless/base
        "@debian13//libc6",
        "@debian13//libssl3t64",
        "@debian13//openssl",
        # required to replicate distroless/cc
        "@debian13//libgcc-s1",
        "@debian13//libgomp1",
        "@debian13//libstdc++6",
        # required to replicate distroless/python
        "@debian13//dash",
        "@debian13//libc-bin",
        "@debian13//python3.13-minimal",
        "@debian13//libpython3.13-stdlib",
    ],
    env = {"LANG": "C.UTF-8"},
)

debian_image(
    name = "build_base_cpp",
    base = ":build_base",
    debian_packages = [
        "@debian13//autotools-dev",
        "@debian13//automake",
        "@debian13//binutils",
        "@debian13//g++",
    ],
)

image(
    name = "build",
    base = "build_base_cpp",
    tars = [
        ":symlinks_layer",
        ":docker_layer",
        ":passwd",
    ],
    visibility = ["//visibility:private"],
)

oci_push(
    name = "push",
    image = ":build",
    remote_tags = ["latest"],
    repository = "index.docker.io/juanzolotoochin/ubuntu-build-v2",
)
