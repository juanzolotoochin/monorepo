build --show_result=2
build --bes_backend=grpcs://remote.buildbuddy.io
build --bes_results_url=https://app.buildbuddy.io/invocation/
build --build_metadata=REPO_URL=https://github.com/juanique/monorepo.git
build --keep_backend_build_event_connections_alive=false
build --incompatible_strict_action_env
build --incompatible_disallow_empty_glob=false

# Detailed timing profile
build --noslim_profile
build --experimental_profile_include_target_label
build --experimental_profile_include_primary_output

## Remote caching
build --remote_download_outputs=minimal
build --remote_cache=grpcs://remote.buildbuddy.io
build --remote_cache_compression
build --remote_build_event_upload=minimal
build --nolegacy_important_outputs
build --remote_instance_name=instance_name_1
build --noremote_upload_local_results

build:remote --remote_executor=grpcs://remote.buildbuddy.io
build:remote --extra_execution_platforms=//:docker_image_platform
build:remote --host_platform=//:docker_image_platform
build:remote --platforms=//:docker_image_platform
build:remote --remote_timeout=1800
build:remote --jobs=50


test --test_output=errors

# Hermetic C++ toolchain
build --incompatible_enable_cc_toolchain_resolution
build --action_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1
build --cxxopt='-std=c++17'
build --host_cxxopt=-std=c++17


# Default target/host/exec platform. rules_rs crate targets require an explicit
# glibc constraint (@llvm//constraints/libc:gnu.2.28) that bare host platforms
# lack, so we point at the rules_rs platforms which carry os/cpu + libc.
#
# The linux x86_64 platform is the base default (covers local linux dev + CI).
# It is set on the base `build` config so that `--config=remote` (applied after
# base flags) cleanly overrides it with //:docker_image_platform, and so that
# the auto `build:macos` config (via --enable_platform_specific_config, applied
# after base flags on macOS hosts) overrides it for local macOS dev.
build --platforms=@rules_rs//rs/platforms:x86_64-unknown-linux-gnu
build --host_platform=@rules_rs//rs/platforms:x86_64-unknown-linux-gnu
build --extra_execution_platforms=@rules_rs//rs/platforms:x86_64-unknown-linux-gnu
common --enable_platform_specific_config
build:macos --platforms=@rules_rs//rs/platforms:aarch64-apple-darwin
build:macos --host_platform=@rules_rs//rs/platforms:aarch64-apple-darwin
build:macos --extra_execution_platforms=@rules_rs//rs/platforms:aarch64-apple-darwin

# fully local build
build:full_local --bes_backend=""
build:full_local --bes_results_url=""
build:full_local --remote_cache=""

common --@aspect_rules_ts//ts:skipLibCheck=honor_tsconfig

# User-level configs
try-import %workspace%/auto.bazelrc
