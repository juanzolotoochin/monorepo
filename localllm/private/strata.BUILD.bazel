# Exercise upstream HTTP budgeting against a mock engine; no model/GPU needed.
py_test(
    name = "context_budget_test",
    srcs = glob([
        "serve/*.py",
        "tools/*.py",
    ]),
    args = [
        "FitMaxTokens",
        "MaxTokens",
        "ThinkingBudget",
    ],
    data = glob([
        "serve/*.jinja",
        "serve/web/**",
    ]),
    legacy_create_init = 0,
    main = "serve/test_server.py",
    deps = [requirement(p) for p in [
        "numpy",
        "jinja2",
        "regex",
        "psutil",
        "pillow",
    ]],
)
