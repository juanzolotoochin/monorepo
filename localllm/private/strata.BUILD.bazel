load("@localllm_pip//:requirements.bzl", "requirement")
load("@monorepo//localllm/private:cuda.bzl", "cuda_library")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_binary(
    name = "server",
    srcs = glob([
        "serve/*.py",
        "tools/*.py",
    ]),
    data = glob([
        "serve/*.jinja",
        "serve/web/**",
    ]),
    legacy_create_init = 0,
    main = "serve/server.py",
    deps = [requirement(p) for p in [
        "numpy",
        "jinja2",
        "regex",
        "psutil",
        "pillow",
    ]],
)

py_binary(
    name = "pack",
    srcs = glob(["tools/*.py"]),
    legacy_create_init = 0,
    main = "tools/iq_pack.py",
    deps = [
        requirement("numpy"),
        requirement("regex"),
    ],
)

exports_files([
    "data/expert-profile.bin",
    "data/draft_vocab.bin",
])

py_library(
    name = "draft_tools",
    srcs = glob(["tools/*.py"]),
    imports = ["tools"],
    deps = [
        "@localllm_ggml//:gguf",
        requirement("numpy"),
    ],
)

cc_library(
    name = "headers",
    hdrs = glob([
        "include/**/*.hpp",
        "include/**/*.h",
        "include/**/*.cuh",
        "third_party/ggml/*.h",
        "src/**/*.hpp",
        "src/**/*.h",
        "src/**/*.cuh",
    ]),
    defines = [
        "STRATA_NATIVE_EXPERTS=1",
        "STRATA_PREFILL_FUSED=1",
        "STRATA_PREFILL_MMQ=1",
        "STRATA_VERSION=\\\"0.1.39\\\"",
    ],
    includes = [
        "include",
        "third_party/ggml",
    ],
    deps = [
        "@localllm_cuda//:headers",
        "@localllm_ggml//:headers",
    ],
)

cc_library(
