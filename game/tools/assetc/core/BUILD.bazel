load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

rust_library(
    name = "voxel_assets",
    srcs = glob(["src/*.rs"]),
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [
        "//game/core:gameplay_core",
