load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

rust_library(
    name = "session",
    srcs = glob(["src/**/*.rs"]),
    edition = "2021",
    visibility = ["//game:__subpackages__"],
    deps = [
        "//game/content",
        "//game/net",
        "//game/save",
        "//game/sim",
    ],
)

rust_test(
    name = "session_test",
    size = "small",
    crate = ":session",
    edition = "2021",
    deps = ["//game/fx"],
)
