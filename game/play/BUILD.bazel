load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

rust_binary(
    name = "play",
    srcs = glob(["src/**/*.rs"]),
    # Bevy's derive macros inspect Cargo.toml to locate the `bevy` re-exports.
    compile_data = ["//:Cargo.toml"],
    edition = "2021",
    rustc_env = {"CARGO_MANIFEST_DIR": "."},
    deps = [
        "//game/content",
        "//game/fx",
        "//game/net",
        "//game/save",
        "//game/sim",
        "//game/view",
        "@crates//:bevy",
    ],
)

rust_test(
    name = "play_test",
    size = "small",
    compile_data = ["//:Cargo.toml"],
    crate = ":play",
    edition = "2021",
    rustc_env = {"CARGO_MANIFEST_DIR": "."},
)
