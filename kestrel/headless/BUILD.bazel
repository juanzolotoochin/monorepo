load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

rust_library(
    name = "headless_lib",
    srcs = [
        "src/lib.rs",
        "src/tests.rs",
    ],
    crate_name = "headless",
    edition = "2021",
    visibility = ["//kestrel:__subpackages__"],
    deps = [
        "//kestrel/content",
        "//kestrel/save",
        "//kestrel/sim",
    ],
)

# The determinism suite: golden hash files, thread count and replay checks.
rust_test(
    name = "determinism_test",
    size = "small",
    compile_data = ["//kestrel/testdata:hashes"],
    crate = ":headless_lib",
    edition = "2021",
)

rust_binary(
    name = "headless",
    srcs = ["src/main.rs"],
    edition = "2021",
    deps = [
        ":headless_lib",
        "//kestrel/content",
        "//kestrel/save",
        "//kestrel/sim",
    ],
)

# Runs the tick benchmark. It holds a budget only when asked to
# (KESTREL_TICK_BUDGET_MS); see bench_test.rs.
rust_test(
    name = "bench_test",
    size = "small",
    srcs = ["bench_test.rs"],
    edition = "2021",
    deps = [
        ":headless_lib",
        "//kestrel/content",
        "//kestrel/sim",
    ],
)
