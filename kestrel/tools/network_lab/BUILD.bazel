load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

# The network lab's delaying UDP relay, started by ../network-lab.ps1.
rust_binary(
    name = "relay",
    srcs = glob(["src/*.rs"]),
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [
        "@crates//:serde",
        "@crates//:serde_json",
    ],
)

rust_test(
    name = "relay_test",
    size = "small",
    crate = ":relay",
    edition = "2021",
)
