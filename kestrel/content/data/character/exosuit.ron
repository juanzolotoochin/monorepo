// The player's articulated exosuit. Durations are 60 Hz frames.
(
    sim: (
        brain: Player,
        body: (radius: 0.32),
        movement: (walk: 3.8, run: 5.6),
        // Frames to pick up or put down one unit.
        carry: (transfer: 24),
        // Hover 1.8 m over the ground ahead, climbing at 5.5 m/s and sinking
        // at 3; digs take 120 frames, stepping to the tile middle at 1.5 m/s.
        abilities: [
            Jetpack(hover: 1.8, climb: 5.5, sink: 3),
            Dig(time: 120, centering: 1.5),
        ],
        avatar: (
            // m/s²: speeding up, slowing down, and stopping for a swing.
            acceleration: 26,
            braking: 32,
            attack_braking: 35,
            attack: (
                windup: 13,
                aim: 10,
                swing: 35,
                sword_windup: 7,
                sword_swing: 26,
                rebound: 25,
                combo_window: 75,
            ),
        ),
    ),
    // Drawn by the scene's actor, posed with the default motion.
    view: (),
)
