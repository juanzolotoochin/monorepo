load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

rust_library(
    name = "net",
    srcs = glob(["src/**/*.rs"]),
    edition = "2021",
    visibility = ["//kestrel:__subpackages__"],
    deps = [
        "//kestrel/content",
        "//kestrel/save",
        "//kestrel/sim",
        "@crates//:postcard",
        "@crates//:serde",
    ],
)

rust_test(
    name = "net_test",
    size = "small",
    # tests::udp_smoke counts ticks over 3 s of real time and fails when the
    # machine is busy. See kestrel/docs/flaky-tests.md.
    flaky = True,
    crate = ":net",
    edition = "2021",
    deps = ["//kestrel/fx"],
)
