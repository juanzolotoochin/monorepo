(id: "north_5", position: (0.0, -8.5), target: (0.0, -1.8), character: "ghoul_sacred_tree", first: 490.0, every: 90.0, count: 3),
(id: "west", position: (-8.5, -2.5), target: (-1.8, -0.6), character: "ghoul_sacred_tree", first: 391.0, every: 90.0, count: 4),
(id: "east_1", position: (8.5, -2.5), target: (1.8, -0.6), character: "ghoul_sacred_tree", first: 481.0, every: 90.0, count: 3),
(id: "east_2", position: (8.5, -2.5), target: (1.8, -0.6), character: "ghoul_sacred_tree", first: 573.5, every: 90.0, count: 2)
], base_health: 20, player_health: 6)
