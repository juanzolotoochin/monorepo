// The Sacred Tree town MVP: a clearing with the tree at its center, on a
// hill in the middle of 256 x 256 m of ground to dig (the scene's mine).
// Its stock is two piles beside it, one per item (each takes only its own),
// starting empty. The elder carries a bundle of one item, up to 5. One Wood
// Gatherer stands built; the clearing's east side has room for more. A
// ballista can be built too, and shoots while manned and stocked. No
// building makes stone: it is dug out of the ground (the scene's stone
// veins, a few exposed 15 to 40 m out), so the stone pile starts empty too.
// Positions are meters from the clearing's center (the scene's x and z).
(id: "sacred_tree", extent: 128.0, items: [
(id: "wood", label: "WOOD", skin: "item_lumber", scale: 0.45),
(id: "stone", label: "STONE", skin: "item_iron", scale: 0.45)
], depots: [
(id: "tree_wood", label: "WOOD PILE", position: (-1.7, 1.7), capacity: 4096, stock: [], only: Some("wood")),
(id: "tree_stone", label: "STONE PILE", position: (1.7, 1.7), capacity: 4096, stock: [], only: Some("stone"))
], sources: [], links: [], agents: [
(id: "elder", label: "ELDER", character: "elder", position: (0.0, 3.4), capacity: 5, one_kind: true, links: [], cargo_anchor: (0.0, 0.65, -0.19), equipment: None, controlled: true)
], sprites: [
(id: "sprite_ash", label: "ASH", character: "sprite", position: (-1.8, 4.6)),
(id: "sprite_fern", label: "FERN", character: "sprite", position: (-0.6, 5.0)),
(id: "sprite_moss", label: "MOSS", character: "sprite", position: (0.6, 5.0)),
(id: "sprite_reed", label: "REED", character: "sprite", position: (1.8, 4.6))
], building_kinds: [
(id: "wood_gatherer", label: "WOOD GATHERER", skin: "mill", radius: 0.9, product: "wood", period: 5.0,
 cap: 10, possessed_cap: 20, possessed_multiplier: 4.0, burst: (units: 5, cooldown: 30.0), health: 10, parts: [
(id: "foundation", label: "FOUNDATION", materials: [(item: "wood", units: 2)]),
(id: "mechanism", label: "MECHANISM", materials: [(item: "wood", units: 2), (item: "stone", units: 2)])
]),
// A ballista shoots the nearest enemy while someone mans it and it has
// stone, one stone a shot; its numbers are the forest's Woodland Ballista's.
// It produces nothing: its pile in front is its ammo, only delivered to.
// A possessing elder throws a fireball with the Burst key: no stone, every
// 25 s; it sets the ground alight, and enemies in the fire burn. Tuned to
// be a strong moment, not a wave-clear: on a column of six it kills about
// two and leaves one hurt (1 where it lands, a 4 s fire, a burn every
// 1.5 s lingering 1 s; a ghoul has 2 health).
(id: "ballista", label: "BALLISTA", skin: "turret", radius: 0.7, health: 10,
 defence: (ammo: "stone", ammo_cap: 10, range: 3.8, period: 0.7, damage: 1, projectile_speed: 8.0,
  fireball: Some((cooldown: 25.0, speed: 6.0, damage: 1, radius: 1.0, fire_radius: 1.5, fire_seconds: 4.0,
   burn_damage: 1, burn_period: 1.5, burn_linger: 1.0))), parts: [
(id: "foundation", label: "FOUNDATION", materials: [(item: "wood", units: 2)]),
(id: "mechanism", label: "MECHANISM", materials: [(item: "wood", units: 2), (item: "stone", units: 2)])
])
], buildings: [
(kind: "wood_gatherer", position: (-5.2, 0.6))
], producers: [], defenders: [],
// Ghouls come after a calm start of 2:45 (time to dig stone, build a
// ballista and stock it): they walk about 63 s from the ring, so the first
// reach the hill's top near 3:50. Then a wave every 90 s, each as big as
// the last or bigger: 3, 5, 6, 7, 8 and 8 ghouls. A scenario has at most 8
// waves, so each entry here is a lane that sends one ghoul a wave
// (`every: 90`) from its first one on: the east lanes 2.5 s apart make a
// column of 3, then 4 from the second wave; the west lanes join one a
// wave from the second, to 4. They come from a ring 40 m out, one side
// per ramp up the tree's hill (the scene's), walk up it to a spot beside
// the trunk (outside its disc) and breach the tree there. Ignored, they
// fell it in the fourth wave; one ballista by the east ramp leaves the
// west lanes to breach (the tree at 6 of 20); one by each ramp keeps it
// whole.
waves: [
(id: "east_1", position: (40.0, 0.0), target: (1.8, -0.6), character: "ghoul_sacred_tree", first: 165.0, every: 90.0, count: 6),
(id: "east_2", position: (40.0, 0.0), target: (1.8, -0.6), character: "ghoul_sacred_tree", first: 167.5, every: 90.0, count: 6),
(id: "east_3", position: (40.0, 0.0), target: (1.8, -0.6), character: "ghoul_sacred_tree", first: 170.0, every: 90.0, count: 6),
(id: "east_4", position: (40.0, 0.0), target: (1.8, -0.6), character: "ghoul_sacred_tree", first: 262.5, every: 90.0, count: 5),
(id: "west_1", position: (-40.0, 0.0), target: (-1.8, -0.6), character: "ghoul_sacred_tree", first: 256.0, every: 90.0, count: 5),
(id: "west_2", position: (-40.0, 0.0), target: (-1.8, -0.6), character: "ghoul_sacred_tree", first: 348.5, every: 90.0, count: 4),
(id: "west_3", position: (-40.0, 0.0), target: (-1.8, -0.6), character: "ghoul_sacred_tree", first: 441.0, every: 90.0, count: 3),
(id: "west_4", position: (-40.0, 0.0), target: (-1.8, -0.6), character: "ghoul_sacred_tree", first: 533.5, every: 90.0, count: 2)
], base_health: 20, player_health: 6)
