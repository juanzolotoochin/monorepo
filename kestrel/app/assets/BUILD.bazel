load("//kestrel/build/voxel_assets:defs.bzl", "boulder_prefab", "scene_assets")

# Scenario files are also read by the new simulation (kestrel/content::scenario).
exports_files(
    [
        "levels/combat_arena_supply.ron",
        "levels/forest_supply.ron",
    ],
    visibility = ["//kestrel:__subpackages__"],
)

package(default_visibility = ["//kestrel/app:__pkg__"])

[
    boulder_prefab(
        name = name,
        src = "prefabs/" + name + ".ron",
        palette = "palette.ron",
    )
    for name in [
        "ore_small",
        "ore_tall",
        "ore_large",
        "ore_flat",
        "ore_narrow",
    ]
]

boulder_prefab(
    name = "dynamic_ore",
    src = "prefabs/ore_large.ron",
    palette = "palette.ron",
    runtime = True,
)

[
    boulder_prefab(
        name = name + "_sample",
        src = "prefabs/mixed_sample.ron" if name == "mixed" else "prefabs/material_sample.ron",
        palette = name + ".ron",
    )
    for name in [
        "metal",
        "crystal",
        "polymer",
        "mixed",
    ]
]

scene_assets(
    name = "mining_deck",
    layout = "levels/mining_deck.ron",
    prefabs = [
        ":ore_small",
        ":ore_tall",
        ":ore_large",
        ":ore_flat",
        ":ore_narrow",
    ],
)

scene_assets(
    name = "boulder_lab",
    layout = "levels/boulder_lab.ron",
    prefabs = [
        ":ore_small",
        ":ore_large",
        ":dynamic_ore",
        ":metal_sample",
        ":crystal_sample",
        ":polymer_sample",
        ":mixed_sample",
    ],
)

scene_assets(
    name = "pile_lab",
    layout = "levels/pile_lab.ron",
    prefabs = [],
)

scene_assets(
    name = "jetpack_lab",
    layout = "levels/jetpack_lab.ron",
    prefabs = [],
)

scene_assets(
    name = "surprise_lab",
    layout = "levels/surprise_lab.ron",
    prefabs = [],
)

# A flat deck with nothing on it, for trying out multiplayer.
scene_assets(
    name = "field",
    layout = "levels/field.ron",
    prefabs = [],
)

# The flat deck, diggable: pits a layer at a time, out with the jetpack.
scene_assets(
    name = "dig_lab",
    layout = "levels/dig_lab.ron",
    prefabs = [],
)

boulder_prefab(
    name = "aether_stone",
    src = "prefabs/ore_small.ron",
    style = "styles/atlantis.ron",
)

scene_assets(
    name = "atlantis",
    layout = "levels/atlantis.ron",
    prefabs = [":aether_stone"],
    style = "styles/atlantis.ron",
)

scene_assets(
    name = "forest_outpost",
    layout = "levels/forest_outpost.ron",
    prefabs = [],
    scenario = "levels/forest_supply.ron",
    style = "styles/forest.ron",
)

scene_assets(
    name = "combat_arena",
    layout = "levels/combat_arena.ron",
    prefabs = [],
    scenario = "levels/combat_arena_supply.ron",
    style = "styles/combat.ron",
)

boulder_prefab(
    name = "glade_rock",
    src = "prefabs/glade_rock.ron",
    palette = "glade_rock.ron",
)

scene_assets(
    name = "moonlit_glade",
    layout = "levels/moonlit_glade.ron",
    prefabs = [":glade_rock"],
    style = "styles/moonlit_glade.ron",
)
