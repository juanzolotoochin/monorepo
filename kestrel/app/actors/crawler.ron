// The crawler's rig (kestrel/CRAWLER.md C8, C12): a brass-and-timber engine
// on four insect legs, drawn from boxes and cylinders until a style supplies
// a `crawler` skin. Where the hips are, how far a leg reaches and the deck's
// height are the simulation's (content/data/character/crawler.ron); this
// says what the body and a leg look like and how long each leg segment is.
//
// The body's pieces are in its frame: the origin on the deck's middle, x to
// the right, y up and z forward. A piece is a box, or a cylinder standing
// along y (its size's x and z its diameter), centered at `at`, and `turn`ed
// by these degrees about x, y and z first.
//
// A leg (the front right; the others mirror it) is a hip turning on the deck
// and three segments solved as a two-bone IK (`app/src/crawler.rs`): the
// thigh up from the hip to a high knee, the shin down to the ankle, and the
// foot, kept upright, from the ankle down to the ground. A segment's pieces
// are in its frame: the origin on the joint it starts from, y along it to
// the next joint, z to the side its knee bends toward (up and out). The
// hip's frame stands upright, z toward its foot.
//
// Materials are the Brasswood palette's (`style` forest): timber and dark
// timber, brass trim, iron, leather, canvas, cloth and a lamp's glow.
(
    body: [
        // The hull hangs under the deck, its belly 1.2 m down
        // (`crawler::BELLY`), and a keel under it.
        (shape: Box, at: (0, -0.58, 0), size: (2.2, 1.0, 5.3), material: Timber),
        (shape: Box, at: (0, -1.12, 0), size: (1.5, 0.16, 4.4), material: DarkTimber),
        (shape: Box, at: (0, -0.32, 0), size: (2.26, 0.1, 5.36), material: Brass),
        (shape: Box, at: (0, -0.86, 0), size: (2.26, 0.08, 5.36), material: Brass),
        // Ribs down the hull's sides.
        (shape: Box, at: (1.12, -0.58, 1.6), size: (0.08, 0.9, 0.16), material: DarkTimber),
        (shape: Box, at: (1.12, -0.58, -1.6), size: (0.08, 0.9, 0.16), material: DarkTimber),
        (shape: Box, at: (-1.12, -0.58, 1.6), size: (0.08, 0.9, 0.16), material: DarkTimber),
        (shape: Box, at: (-1.12, -0.58, -1.6), size: (0.08, 0.9, 0.16), material: DarkTimber),
        // The deck's planks, its brass edge and a prow with a lamp.
        (shape: Box, at: (0, -0.06, 0), size: (2.5, 0.12, 5.7), material: Timber),
        (shape: Box, at: (0, -0.1, 0), size: (2.6, 0.06, 5.8), material: Brass),
        (shape: Box, at: (0, -0.5, 2.78), size: (1.4, 0.7, 0.3), material: Brass),
        (shape: Cylinder, at: (0, -0.45, 2.98), size: (0.38, 0.14, 0.38), turn: (90, 0, 0), material: Lamp),
        // The cab, on the deck's front half: timber walls, a dark window
        // band, a brass roof and a stack; the pilot stands at the helm
        // behind it, on the deck's middle.
        (shape: Box, at: (0, 0.55, 1.55), size: (1.9, 1.1, 1.5), material: Timber),
        (shape: Box, at: (0, 0.86, 1.55), size: (1.94, 0.26, 1.54), material: Iron),
        (shape: Box, at: (0, 0.12, 1.55), size: (1.96, 0.12, 1.56), material: Brass),
        (shape: Box, at: (0, 1.16, 1.55), size: (2.1, 0.14, 1.75), material: Brass),
        (shape: Box, at: (0, 1.27, 1.55), size: (1.5, 0.1, 1.2), material: Brass),
        (shape: Cylinder, at: (0.55, 1.75, 1.95), size: (0.34, 1.1, 0.34), material: Iron),
        (shape: Cylinder, at: (0.55, 2.28, 1.95), size: (0.44, 0.1, 0.44), material: Brass),
        (shape: Cylinder, at: (-0.55, 1.42, 1.9), size: (0.5, 0.3, 0.5), material: Brass),
        // The helm.
        (shape: Cylinder, at: (0, 0.42, 0.6), size: (0.12, 0.84, 0.12), material: Brass),
        (shape: Cylinder, at: (0, 0.86, 0.55), size: (0.62, 0.05, 0.62), turn: (75, 0, 0), material: Brass),
        // The cargo deck on the back half: a brass rail round it, crates
        // lashed under canvas.
        (shape: Cylinder, at: (1.2, 0.32, -0.45), size: (0.08, 0.64, 0.08), material: Brass),
        (shape: Cylinder, at: (-1.2, 0.32, -0.45), size: (0.08, 0.64, 0.08), material: Brass),
        (shape: Cylinder, at: (1.2, 0.32, -1.7), size: (0.08, 0.64, 0.08), material: Brass),
        (shape: Cylinder, at: (-1.2, 0.32, -1.7), size: (0.08, 0.64, 0.08), material: Brass),
        (shape: Cylinder, at: (1.2, 0.32, -2.8), size: (0.08, 0.64, 0.08), material: Brass),
        (shape: Cylinder, at: (-1.2, 0.32, -2.8), size: (0.08, 0.64, 0.08), material: Brass),
        (shape: Box, at: (1.2, 0.64, -1.63), size: (0.07, 0.07, 2.42), material: Brass),
        (shape: Box, at: (-1.2, 0.64, -1.63), size: (0.07, 0.07, 2.42), material: Brass),
        (shape: Box, at: (0, 0.64, -2.8), size: (2.47, 0.07, 0.07), material: Brass),
        (shape: Box, at: (-0.45, 0.3, -1.35), size: (0.8, 0.6, 0.8), material: Timber),
        (shape: Box, at: (0.5, 0.25, -2.2), size: (0.75, 0.5, 0.7), material: Timber),
        (shape: Box, at: (0.45, 0.2, -1.2), size: (0.7, 0.4, 0.6), material: DarkTimber),
        (shape: Box, at: (0.05, 0.42, -1.75), size: (1.6, 0.5, 1.4), material: Canvas),
        (shape: Box, at: (0.05, 0.42, -1.75), size: (1.64, 0.06, 0.08), material: Leather),
        (shape: Box, at: (0.05, 0.42, -1.75), size: (0.08, 0.54, 1.44), material: Leather),
        (shape: Box, at: (-0.9, 0.95, -2.75), size: (0.04, 1.3, 0.04), material: Iron),
        (shape: Box, at: (-0.9, 1.45, -2.98), size: (0.03, 0.3, 0.42), material: Cloth),
    ],
    leg: (
        // A brass drum on the deck's corner the leg turns on.
        hip: [
            (shape: Cylinder, at: (0, -0.1, 0), size: (0.72, 0.5, 0.72), material: Brass),
            (shape: Cylinder, at: (0, 0.2, 0), size: (0.5, 0.12, 0.5), material: Iron),
        ],
        // Up to the knee, which stands over the hip: long enough with the
        // shin for the farthest foot (`reach`, 4.5 m), the shin nearly
        // twice as long so the knee stands high, but not so much longer
        // that a near foot is out of the folded leg's reach.
        thigh: (
            length: 1.8,
            pieces: [
                (shape: Box, at: (0, 0.9, 0), size: (0.3, 1.8, 0.36), material: Timber),
                (shape: Box, at: (0, 0.35, 0), size: (0.36, 0.12, 0.42), material: Brass),
                (shape: Box, at: (0, 1.45, 0), size: (0.36, 0.12, 0.42), material: Brass),
                (shape: Cylinder, at: (0, 0.9, -0.24), size: (0.12, 1.2, 0.12), material: Iron),
                (shape: Cylinder, at: (0, 1.8, 0), size: (0.5, 0.5, 0.5), turn: (0, 0, 90), material: Brass),
            ],
        ),
        shin: (
            length: 3.4,
            pieces: [
                (shape: Box, at: (0, 1.55, 0), size: (0.28, 3.1, 0.32), material: Timber),
                (shape: Box, at: (0, 0.45, 0), size: (0.34, 0.12, 0.38), material: Brass),
                (shape: Box, at: (0, 1.6, 0), size: (0.32, 0.1, 0.36), material: Brass),
                (shape: Box, at: (0, 2.8, 0), size: (0.3, 0.1, 0.34), material: Brass),
                (shape: Box, at: (0, 0.5, 0.24), size: (0.1, 0.5, 0.14), material: Iron),
                (shape: Cylinder, at: (0, 3.4, 0), size: (0.34, 0.36, 0.34), turn: (0, 0, 90), material: Iron),
            ],
        ),
        // Short and upright, from the ankle to a broad pad on the ground.
        foot: (
            length: 0.45,
            pieces: [
                (shape: Cylinder, at: (0, 0.2, 0), size: (0.22, 0.4, 0.22), material: Iron),
                (shape: Cylinder, at: (0, 0.38, 0), size: (0.62, 0.14, 0.62), material: Brass),
                (shape: Cylinder, at: (0, 0.43, 0), size: (0.7, 0.04, 0.7), material: DarkTimber),
            ],
        ),
    ),
)
