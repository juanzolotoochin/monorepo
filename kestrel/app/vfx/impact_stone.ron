// A blade striking stone: hot sparks, rock chips, a contact flash and a short
// orange light. Port of the hand-written `effects::impact` for
// `ImpactResponse::Stone` (VFX spike step 2). The format is in README.md.
//
// The effect is placed at the contact point with local +Y along the surface
// normal; gravity and the floor are in world space.
(
    version: 1,
    particles: (
        sprinkles_version: "0.3",
        name: "impact_stone",
        dimension: D3,
        despawn_on_finish: true,
        emitters: [
            (
                name: "sparks",
                initial_transform: (translation: (0.0, 0.06, 0.0)),
                // 0.28 to 0.8 s, as before.
                time: (lifetime: 0.8, lifetime_randomness: 0.65, one_shot: true, explosiveness: 1.0),
                draw_pass: (
                    // Thin glowing bars, 0.2 to 0.4 m long, pointing along their flight.
                    mesh: Cuboid(half_size: (0.0225, 0.15, 0.0225)),
                    material: Standard((
                        // Hot orange, glowing for bloom: linear (12.0, 4.56, 0.96).
                        base_color: (1.0, 0.38, 0.08, 1.0),
                        emissive: (2.9161, 1.9303, 0.9822, 1.0),
                    )),
                    transform_align: Some(YToVelocity),
                    // Small particles go without shadows (README.md).
                    shadow_caster: false,
                    visibility_aabb: (center: (0.0, 0.0, 0.0), half_extents: (4.0, 4.0, 4.0)),
                ),
                emission: (particles_amount: 12),
                scale: (range: (min: 0.67, max: 1.33), scale_over_lifetime: Some((
                    name: Some("Shrink"),
                    // (1 - t)^0.65, sampled.
                    x: (points: [
                        (position: 0.0, value: 1.0, mode: SingleCurve),
                        (position: 0.25, value: 0.83, mode: SingleCurve),
                        (position: 0.5, value: 0.64, mode: SingleCurve),
                        (position: 0.75, value: 0.41, mode: SingleCurve),
                        (position: 0.9, value: 0.22, mode: SingleCurve),
                        (position: 1.0, value: 0.0, mode: SingleCurve),
                    ], range: (min: 0.0, max: 1.0)),
                ))),
                velocities: (
                    initial_direction: (0.0, 1.0, 0.0),
                    spread: 45.0,
                    initial_velocity: (min: 2.5, max: 7.5),
                    // The legacy sprays lean upward: normal + up 0.46 on average.
                    world_bias: (0.0, 0.46, 0.0),
                ),
                accelerations: (gravity: (0.0, -14.0, 0.0)),
                // Rests 4.5 cm above the floor; keeps a third of its fall speed and two thirds of its slide.
                collision: (mode: Some(Rigid(friction: 0.35, bounce: 0.32)), base_size: 0.09),
            ),
            (
                name: "debris",
                initial_transform: (translation: (0.0, 0.06, 0.0)),
                time: (lifetime: 0.8, lifetime_randomness: 0.65, one_shot: true, explosiveness: 1.0),
                draw_pass: (
                    // Chips 6 to 14 cm across.
                    mesh: Cuboid(half_size: (0.05, 0.05, 0.05)),
                    material: Standard((
                        // The dark rock.
                        base_color: (0.14, 0.17, 0.23, 1.0),
                        perceptual_roughness: 0.72,
                        metallic: 0.1,
                    )),
                    transform_align: Some(YToVelocity),
                    // Small particles go without shadows (README.md).
                    shadow_caster: false,
                    visibility_aabb: (center: (0.0, 0.0, 0.0), half_extents: (4.0, 4.0, 4.0)),
                ),
                emission: (particles_amount: 18),
                scale: (range: (min: 0.6, max: 1.4), scale_over_lifetime: Some((
                    name: Some("Shrink"),
                    x: (points: [
                        (position: 0.0, value: 1.0, mode: SingleCurve),
                        (position: 0.25, value: 0.83, mode: SingleCurve),
                        (position: 0.5, value: 0.64, mode: SingleCurve),
                        (position: 0.75, value: 0.41, mode: SingleCurve),
                        (position: 0.9, value: 0.22, mode: SingleCurve),
                        (position: 1.0, value: 0.0, mode: SingleCurve),
                    ], range: (min: 0.0, max: 1.0)),
                ))),
                velocities: (
                    initial_direction: (0.0, 1.0, 0.0),
                    spread: 45.0,
                    initial_velocity: (min: 2.5, max: 7.5),
                    // The legacy sprays lean upward: normal + up 0.46 on average.
                    world_bias: (0.0, 0.46, 0.0),
                ),
                accelerations: (gravity: (0.0, -14.0, 0.0)),
                collision: (mode: Some(Rigid(friction: 0.35, bounce: 0.32)), base_size: 0.09),
            ),
            (
                name: "flash",
                // One hot cube at the contact for about four frames.
                time: (lifetime: 0.065, one_shot: true, explosiveness: 1.0),
                draw_pass: (
                    mesh: Cuboid(half_size: (0.08, 0.08, 0.08)),
                    material: Standard((
                        base_color: (1.0, 0.38, 0.08, 1.0),
                        emissive: (2.9161, 1.9303, 0.9822, 1.0),
                    )),
                ),
                emission: (particles_amount: 1),
                scale: (range: (min: 1.0, max: 1.0), scale_over_lifetime: Some((
                    name: Some("Shrink"),
                    x: (points: [
                        (position: 0.0, value: 1.0, mode: SingleCurve),
                        (position: 0.5, value: 0.64, mode: SingleCurve),
                        (position: 1.0, value: 0.0, mode: SingleCurve),
                    ], range: (min: 0.0, max: 1.0)),
                ))),
                velocities: (spread: 0.0),
                accelerations: (gravity: (0.0, 0.0, 0.0)),
            ),
        ],
    ),
    lights: [
        (
            color: (1.0, 0.38, 0.08),
            intensity: 18000.0,
            range: 4.5,
            radius: 0.15,
            // Meters along the normal.
            offset: 0.2,
            fade_seconds: 0.1,
        ),
    ],
)
