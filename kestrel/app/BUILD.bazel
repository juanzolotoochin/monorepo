alias(
    name = "web",
    actual = "//kestrel/app/web:web",
    visibility = ["//visibility:public"],
)

alias(
    name = "share_to_devs",
    actual = "//kestrel/tools/telegram:publish",
    visibility = ["//visibility:public"],
)

rust_binary(
    name = "demo",
    srcs = glob(["src/**/*.rs"]),
    # Bevy's derive macros inspect Cargo.toml to locate the `bevy` re-exports.
    compile_data = ["//:Cargo.toml", "actors/exosuit.ron", "shaders/cutaway.wesl", "shaders/cutaway_prepass.wesl", "shaders/fog_dressing.wesl", "shaders/grass.wesl"] + glob(["vfx/*.ron"]),
    edition = "2021",
    link_deps = select({
        "@platforms//cpu:wasm32": [],
        "@platforms//os:linux": [":sound", "//salsa/tools/midi_keys:native"],
        "//conditions:default": [":sound"],
    }),
    rustc_env = {"CARGO_MANIFEST_DIR": "."},
    visibility = ["//visibility:public"],
    deps = [
        "//kestrel/app/assets:asset_guide",
        "//kestrel/app/assets:atlantis",
        "//kestrel/app/assets:boulder_lab",
        "//kestrel/app/assets:combat_arena",
        "//kestrel/app/assets:dig_lab",
        "//kestrel/app/assets:field",
        "//kestrel/app/assets:forest_outpost",
        "//kestrel/app/assets:jetpack_lab",
        "//kestrel/app/assets:laser_pit",
        "//kestrel/app/assets:mining_deck",
        "//kestrel/app/assets:moonlit_glade",
        "//kestrel/app/assets:pile_lab",
        "//kestrel/app/assets:sacred_tree",
        "//kestrel/app/assets:surprise_lab",
        "//kestrel/app/assets:tunnel_lab",
        "//kestrel/content",
        "//kestrel/debug_ui",
        "//kestrel/fx",
        "//kestrel/net",
        "//kestrel/save",
        "//kestrel/service",
        "//kestrel/session",
        "//kestrel/sim",
        "//kestrel/tools/assetc/core:voxel_assets",
        "//kestrel/vfx/sprinkles:bevy_sprinkles",
        "@crates//:bevy",
        "@crates//:image",
        "@crates//:ron",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:web-time",
        "@crates//:wasm-bindgen",
    ] + select({
        # The native controller backend (see input/native.rs).
        "@platforms//os:windows": ["@crates//:bevy_gilrs"],
        "@platforms//os:linux": ["@crates//:bevy_gilrs"],
        "//conditions:default": [],
    }),
)

go_binary(
    name = "steamdeck",
    srcs = ["steamdeck.go"],
    args = [
        "$(rlocationpath :demo)",
        "$(rlocationpath deck_launch.sh)",
    ],
    data = [
        ":demo",
        "deck_launch.sh",
    ],
    deps = [
        "@com_github_klauspost_compress//zstd",
        "@org_golang_x_crypto//ssh",
        "@org_golang_x_crypto//ssh/agent",
        "@org_golang_x_crypto//ssh/knownhosts",
    ],
    visibility = ["//visibility:public"],
)

arm64_game(
    name = "frame_demo",
    game = ":demo",
)

go_binary(
    name = "steamframe",
    srcs = ["steamdeck.go"],
    args = [
        "$(rlocationpath :frame_demo)",
        "$(rlocationpath deck_launch.sh)",
        "--device=frame",
    ],
    data = [
        ":frame_demo",
        "deck_launch.sh",
    ],
    deps = [
        "@com_github_klauspost_compress//zstd",
        "@org_golang_x_crypto//ssh",
        "@org_golang_x_crypto//ssh/agent",
        "@org_golang_x_crypto//ssh/knownhosts",
    ],
    visibility = ["//visibility:public"],
)

