# The Sacred Tree's depths through a day and a night (M8.8 of the depths
# design): the elder digs a stair down at the west ramp's foot and a tunnel
# on from it (the plain dig, F), puts a lantern's blueprint on the stair,
# the miners bring its stone and amber and build it and mine the stair's
# walls in its light (at 4x between), then at dusk the elder lures two
# ghouls of the west column down into the lit tunnel, and at dawn the last
# ghoul burns away by the ramp.
game_demo(
    name = "sacred_tree_depths_demo",
    game = ":demo",
    script = "demos/sacred_tree_depths.json",
    tags = ["manual"],
)

filegroup(
    name = "sacred_tree_depths_demo_video",
    srcs = [":sacred_tree_depths_demo"],
    output_group = "video",
)

# The Sacred Tree's fog of war (M9.2 of the fog design, the review demo
# since M9.4): by day the elder looks out from the hill's north-west corner,
# walks west down the ramp, the fog opening and staying remembered (a pile
# dropped and a site laid out west stay as last seen, M9.3), lays a lantern
# site that two miners build, and goes round to the mountain's cave at 2x,
# waiting in its passage at 4x. It comes out late in the day: dusk halves
# its sight by the lantern, whose pool stays in sight; at the west ramp's
# foot the night's column is heard by its eyes (a growl), then a ghoul is in
# sight, and the elder walks on past the lantern's pool. 3117 frames.
game_demo(
    name = "sacred_tree_fog_demo",
    game = ":demo",
    script = "demos/sacred_tree_fog.json",
    tags = ["manual"],
)

filegroup(
    name = "sacred_tree_fog_demo_video",
    srcs = [":sacred_tree_fog_demo"],
    output_group = "video",
)

