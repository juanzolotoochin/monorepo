load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

rust_library(
    name = "view",
    srcs = glob(["src/**/*.rs"]),
    # Bevy's derive macros inspect Cargo.toml to locate the `bevy` re-exports.
    compile_data = ["//:Cargo.toml"],
    edition = "2021",
    rustc_env = {"CARGO_MANIFEST_DIR": "."},
    visibility = ["//kestrel:__subpackages__"],
    deps = [
        "//kestrel/sim",
        "@crates//:bevy",
    ],
)

rust_test(
    name = "view_test",
    size = "small",
    compile_data = ["//:Cargo.toml"],
    crate = ":view",
    edition = "2021",
    rustc_env = {"CARGO_MANIFEST_DIR": "."},
)
