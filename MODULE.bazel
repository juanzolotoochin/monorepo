# Several no_std-capable crates in gpui's font/text stack need their default
# `std` feature, which from_cargo did not enable, leaving float math
# (sqrt/sin_cos/tan/...) unavailable. Force `std` on each.
crate.annotation(
    crate = "zeno",
    crate_features = ["std"],
)
crate.annotation(
    crate = "skrifa",
    crate_features = ["std"],
)
crate.annotation(
    crate = "read-fonts",
    crate_features = ["std"],
)

# gpui gates its inspector code on `any(feature = "inspector", debug_assertions)`,
# so debug-config builds reference `derive_inspector_reflection`. That macro
# lives in the gpui-macros proc-macro crate behind the same cfg, but proc-macro
# crates build in the exec config (opt, debug_assertions off), so the macro is
# absent unless its `inspector` feature is on. Enable it. (The crate is named
# `gpui-macros`; gpui renames it to `gpui_macros`.)
crate.annotation(
    crate = "gpui-macros",
    crate_features = ["inspector"],
)

# freetype-sys links a host freetype found via pkg-config when one exists,
# which is non-hermetic. Skip pkg-config so it always builds its bundled copy.
# CXXSTDLIB is cleared because the bundled copy is compiled as C++ and the cc
# crate would otherwise request libstdc++; the @llvm toolchain already links
# libc++.
crate.annotation(
    build_script_env = {
        "CXXSTDLIB": "",
        "FREETYPE2_NO_PKG_CONFIG": "1",
    },
    crate = "freetype-sys",
)

# gpui's Linux backend links the system X11/xkb libraries. The @llvm toolchain
# has no sysroot, so provide them from Debian 13 packages (see //third_party/x11).
crate.annotation(
    crate = "xkbcommon",
    deps = [
        "@//third_party/x11:xcb",
        "@//third_party/x11:xkbcommon",
        "@//third_party/x11:xkbcommon-x11",
    ],
)
crate.annotation(
    crate = "x11rb",
    deps = ["@//third_party/x11:xcb"],
)
use_repo(crate, "crates")

