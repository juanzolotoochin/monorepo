load("//bazel/voxel_assets:defs.bzl", "boulder_prefab", "scene_assets")

package(default_visibility = ["//examples/rust/bevy_isometric:__pkg__"])

[
    boulder_prefab(
        name = name,
        src = "prefabs/" + name + ".ron",
        palette = "palette.ron",
    )
    for name in [
        "ore_small",
        "ore_tall",
        "ore_large",
        "ore_flat",
        "ore_narrow",
    ]
]

boulder_prefab(
    name = "dynamic_ore",
    src = "prefabs/ore_large.ron",
    palette = "palette.ron",
    runtime = True,
)

[
    boulder_prefab(
        name = name + "_sample",
        src = "prefabs/mixed_sample.ron" if name == "mixed" else "prefabs/material_sample.ron",
        palette = name + ".ron",
    )
    for name in [
        "metal",
        "crystal",
        "polymer",
        "mixed",
    ]
]

scene_assets(
    name = "mining_deck",
    layout = "levels/mining_deck.ron",
    prefabs = [
        ":ore_small",
        ":ore_tall",
        ":ore_large",
        ":ore_flat",
        ":ore_narrow",
    ],
)

scene_assets(
    name = "boulder_lab",
    layout = "levels/boulder_lab.ron",
    prefabs = [
        ":ore_small",
        ":ore_large",
        ":dynamic_ore",
        ":metal_sample",
        ":crystal_sample",
        ":polymer_sample",
        ":mixed_sample",
    ],
)

scene_assets(
    name = "pile_lab",
    layout = "levels/pile_lab.ron",
    prefabs = [],
)

scene_assets(
    name = "jetpack_lab",
    layout = "levels/jetpack_lab.ron",
    prefabs = [],
)
