load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

rust_binary(
    name = "demo",
    srcs = glob(["src/**/*.rs"]),
    # Bevy's derive macros inspect Cargo.toml to locate the `bevy` re-exports.
    compile_data = ["//:Cargo.toml"],
    edition = "2021",
    # Let Bazel drive clang-cl's link action. Rust's MSVC linker arguments
    # otherwise reach clang-cl as compiler arguments when cross-compiling.
    experimental_use_cc_common_link = select({
        "//platforms:windows_msvc": 1,
        "//conditions:default": -1,
    }),
    link_deps = [":sound"] + select({
        "//platforms:windows_msvc": [":windows_system_libs"],
        "//conditions:default": [],
    }),
    rustc_env = {"CARGO_MANIFEST_DIR": "."},
    visibility = ["//visibility:public"],
    deps = [
        "//examples/rust/bevy_isometric/assets:boulder_lab",
        "//examples/rust/bevy_isometric/assets:mining_deck",
        "//examples/rust/bevy_isometric/assets:pile_lab",
        "//tools/assetc/core:voxel_assets",
        "@crates//:bevy",
    ],
)

rust_test(
    name = "movement_test",
    size = "small",
    compile_data = ["//:Cargo.toml"],
    crate = ":demo",
    edition = "2021",
    experimental_use_cc_common_link = select({
        "//platforms:windows_msvc": 1,
        "//conditions:default": -1,
    }),
    rustc_env = {"CARGO_MANIFEST_DIR": "."},
)

cc_library(
    name = "sound",
    srcs = ["src/sound.c"],
    copts = ["-O2"],
    deps = ["@miniaudio//:headers"],
)

# Explicit SDK imports needed by winit touch input and Rust's Windows pipes
# when Bazel links the Rust objects through cc_common instead of rustc.
cc_library(
    name = "windows_system_libs",
    linkopts = [
        "user32.lib",
        "ntdll.lib",
    ],
    target_compatible_with = [
        "@platforms//os:windows",
        "@llvm//constraints/windows/abi:msvc",
    ],
)
