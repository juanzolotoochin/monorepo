load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_python//python:defs.bzl", "py_test")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("//bazel/game_demo:defs.bzl", "game_demo")

rust_binary(
    name = "demo",
    srcs = glob(["src/**/*.rs"]),
    # Bevy's derive macros inspect Cargo.toml to locate the `bevy` re-exports.
    compile_data = ["//:Cargo.toml"],
    edition = "2021",
    # Let Bazel drive clang-cl's link action. Rust's MSVC linker arguments
    # otherwise reach clang-cl as compiler arguments when cross-compiling.
    experimental_use_cc_common_link = select({
        "//platforms:windows_msvc": 1,
        "//conditions:default": -1,
    }),
    link_deps = [":sound"] + select({
        "//platforms:windows_msvc": [":windows_system_libs"],
        "//conditions:default": [],
    }),
    rustc_env = {"CARGO_MANIFEST_DIR": "."},
    visibility = ["//visibility:public"],
    deps = [
        "//examples/rust/bevy_isometric/assets:atlantis",
        "//examples/rust/bevy_isometric/assets:boulder_lab",
        "//examples/rust/bevy_isometric/assets:jetpack_lab",
        "//examples/rust/bevy_isometric/assets:mining_deck",
        "//examples/rust/bevy_isometric/assets:pile_lab",
        "//examples/rust/bevy_isometric/assets:surprise_lab",
        "//tools/assetc/core:voxel_assets",
        "//tools/gameplay/core:gameplay_core",
        "@crates//:bevy",
        "@crates//:serde",
        "@crates//:serde_json",
    ],
)

rust_test(
    name = "movement_test",
    size = "small",
    compile_data = ["//:Cargo.toml"],
    crate = ":demo",
    edition = "2021",
    experimental_use_cc_common_link = select({
        "//platforms:windows_msvc": 1,
        "//conditions:default": -1,
    }),
    rustc_env = {"CARGO_MANIFEST_DIR": "."},
)

cc_library(
    name = "sound",
    srcs = ["src/sound.c"],
    copts = ["-O2"],
    deps = ["@miniaudio//:headers"],
)

# Explicit SDK imports needed by winit touch input and Rust's Windows pipes
# when Bazel links the Rust objects through cc_common instead of rustc.
cc_library(
    name = "windows_system_libs",
    linkopts = [
        "user32.lib",
        "ntdll.lib",
    ],
    target_compatible_with = [
        "@platforms//os:windows",
        "@llvm//constraints/windows/abi:msvc",
    ],
)

game_demo(
    name = "haul_four_demo",
    game = ":demo",
    script = "demos/haul_four.json",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:linux"],
)

py_test(
    name = "control_protocol_test",
    size = "small",
    srcs = ["tests/control_protocol_test.py"],
    args = ["$(rootpath :demo)"],
    data = [":demo"],
    legacy_create_init = 0,
)

game_demo(
    name = "jetpack_demo",
    game = ":demo",
    script = "demos/jetpack.json",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:linux"],
)

game_demo(
    name = "surprise_demo",
    game = ":demo",
    script = "demos/surprise.json",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:linux"],
)

game_demo(
    name = "atlantis_demo",
    game = ":demo",
    script = "demos/atlantis.json",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:linux"],
)
