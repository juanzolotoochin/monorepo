load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_python//python:defs.bzl", "py_test")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

rust_library(
    name = "keyboard",
    srcs = ["src/lib.rs"],
    edition = "2021",
)

rust_binary(
    name = "midi_keys",
    srcs = ["src/main.rs"],
    edition = "2021",
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//visibility:public"],
    deps = [
        ":keyboard",
        ":native",
        ":piano",
        ":trainer",
        ":ui",
    ],
)

rust_library(
    name = "ui",
    data = ["assets/BRAVURA-LICENSE.txt", "assets/BRAVURA-FONTLOG.txt", "assets/LIBERATION-LICENSE.txt"],
    srcs = ["src/ui.rs", "src/notation.rs", "src/staff_notation.rs", "src/music_glyphs.rs", "src/chord_glyphs.rs", "src/kitty_coordinates.rs"],
    crate_root = "src/ui.rs",
    edition = "2021",
    deps = [
        ":keyboard",
        ":trainer",
        "@crates//:ratatui",
        "@crates//:flate2-1.1.9",
    ],
)

rust_library(
    name = "trainer",
    srcs = [
        "src/browser.rs",
        "src/debug_capture.rs",
        "src/courses.rs",
        "src/tempo.rs",
        "src/curriculum.rs",
        "src/curriculum_analysis.rs",
        "src/exercise.rs",
        "src/evidence.rs",
        "src/learner.rs",
        "src/music.rs",
        "src/performance.rs",
        "src/practice.rs",
        "src/recognition.rs",
        "src/rhythm.rs",
        "src/reading.rs",
        "src/score_support.rs",
        "src/practice_tests.rs",
        "src/spelling.rs",
        "src/tests.rs",
        "src/trainer.rs",
    ],
    crate_root = "src/trainer.rs",
    edition = "2021",
    deps = [
        ":keyboard",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:tempfile",
    ],
)

rust_test(
    name = "trainer_test",
    size = "small",
    crate = ":trainer",
    edition = "2021",
)

rust_test(
    name = "ui_test",
    size = "small",
    crate = ":ui",
    edition = "2021",
)

rust_binary(
    name = "ui_preview",
    testonly = True,
    srcs = ["src/ui_preview.rs"],
    edition = "2021",
    deps = [
        ":keyboard",
        ":trainer",
        ":ui",
        "@crates//:tempfile",
    ],
)

rust_library(
    name = "piano",
    srcs = ["src/piano.rs", "src/count_in.rs"],
    compile_data = ["assets/count-in/count-in.sf2"],
    crate_root = "src/piano.rs",
    data = ["@salamander_piano//:soundfont", "@generaluser_drums//:soundfont", "@generaluser_drums//:license", "assets/count-in/NOTICE.txt"],
    edition = "2021",
    rustc_env = {
        "MIDI_PIANO_SF2": "$(rlocationpath @salamander_piano//:soundfont)",
        "MIDI_DRUMS_SF2": "$(rlocationpath @generaluser_drums//:soundfont)",
    },
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":audio_native",
        ":keyboard",
        "@crates//:rustysynth",
    ],
)

cc_library(
    name = "audio_native",
    srcs = ["src/audio.c"],
    copts = ["-O2"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = ["@miniaudio//:headers"],
)

rust_test(
    name = "piano_test",
    size = "large",
    crate = ":piano",
    data = ["@salamander_piano//:soundfont", "@generaluser_drums//:soundfont", "@generaluser_drums//:license", "assets/count-in/NOTICE.txt"],
    edition = "2021",
    target_compatible_with = ["@platforms//os:linux"],
)

cc_library(
    name = "native",
    srcs = ["src/native.c"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = ["//third_party/alsa"],
)

rust_test(
    name = "keyboard_test",
    size = "small",
    crate = ":keyboard",
    edition = "2021",
)

py_test(
    name = "terminal_test",
    size = "small",
    srcs = ["terminal_test.py"],
    data = [":midi_keys"],
    legacy_create_init = 0,
    target_compatible_with = ["@platforms//os:linux"],
)
